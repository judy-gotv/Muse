# Mapi .env 模板 (VPS 版, 复制为 /opt/mapi/.env, 权限 600)
# 已核实 (remote_import.rs 直读): M2RS_DATA_DIR / M2RS_FULL_BROWSER_BIN / M2RS_XVFB_BIN
M2RS_DATA_DIR=/opt/mapi/data
M2RS_FULL_BROWSER_BIN=/usr/bin/chromium
M2RS_XVFB_BIN=/usr/bin/Xvfb
# 已确认 (src/config.rs): M2RS_PORT / M2RS_API_KEY 为主, 其余为兼容导出
M2RS_PORT=18611
M2RS_HOST=0.0.0.0
M2RS_API_KEY=请改成你自己的64位hex密钥
MAPI_PORT=18611
MAPI_KEY=请改成你自己的64位hex密钥
PORT=18611
