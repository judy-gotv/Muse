[Unit]
Description=Muse-Api - Muse account pool bridge (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muse-api
Group=muse-api
WorkingDirectory=/opt/muse-api
EnvironmentFile=/opt/muse-api/.env
ExecStart=/opt/muse-api/muse-api
Restart=always
RestartSec=3
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
